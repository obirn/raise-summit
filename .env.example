# Copy to .env and fill in. .env is gitignored — never commit real keys.
GEMINI_API_KEY=
# DEMO-ONLY: real telephony path. Not needed for `make demo` (demo mode bypasses Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-live-preview
BOARD_DB_PATH=board.db
BOARD_LOG_PATH=board_events.jsonl
DEMO_MODE=1
