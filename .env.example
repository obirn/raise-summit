# Copy to .env and fill in. .env is gitignored — never commit real keys.
GEMINI_API_KEY=
# DEMO-ONLY: real telephony path. Not needed for `make demo` (demo mode bypasses Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-live-preview   # voice bridge (Gemini Live)
CU_MODEL=gemini-2.5-computer-use-preview-10-2025
CU_MODE=stub                                 # stub | real (real Gemini Computer Use)
AGENT_MODE=deterministic                     # deterministic | agentic (spawn LLM solver agents)
AGENT_BRAIN=scripted                         # scripted (offline) | gemini (real planner)
AGENT_MODEL=gemini-2.5-flash                 # planner model for the solver agents
ORCH_URL=http://localhost:5000               # voice bridge -> orchestrator
PORTAL_BASE_URL=http://localhost:5173
BOARD_DB_PATH=board.db
BOARD_LOG_PATH=board_events.jsonl
DEMO_MODE=1
