# Copy to .env and fill in. .env is gitignored — never commit real keys.
GEMINI_API_KEY=
# DEMO-ONLY: real telephony path. Not needed for `make demo` (demo mode bypasses Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-live-preview   # voice bridge (Gemini Live)
CU_MODEL=gemini-2.5-computer-use-preview-10-2025
CU_MODE=stub                                 # stub | real (real Gemini Computer Use)
AGENT_MODE=deterministic                     # deterministic | agentic (spawn LLM solver agents)
AGENT_BRAIN=scripted                         # scripted (offline) | gemini | antigravity
AGENT_MODEL=gemini-2.5-flash                 # planner model (gemini brain / antigravity model-variant)
ANTIGRAVITY_VARIANT=agent                    # agent (literal, remote sandbox, slower) | model (fast, no sandbox, still durable resume-by-id)
ORCH_URL=http://localhost:5000               # voice bridge -> orchestrator
VOICE_MODE=stub                              # stub (log only) | bridge (speak resolution back into the OPEN live call)
BRIDGE_URL=http://localhost:8080             # orchestrator -> voice bridge /speak (live speak-back)
VAD_SILENCE_MS=550                           # Live VAD: silence (ms) before the agent replies (lower = snappier)
VAD_PREFIX_MS=200
PORTAL_BASE_URL=http://localhost:5173
BOARD_DB_PATH=board.db
BOARD_LOG_PATH=board_events.jsonl
DEMO_MODE=1
